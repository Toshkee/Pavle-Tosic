{
  "name": "my-portofolio",
  "compatibility_date": "2026-05-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pavletosic.com",
      "custom_domain": true
    }
  ],
  // worker.ts wraps OpenNext's generated .open-next/worker.js.
  "main": "worker.ts",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The asset server ignores Range, so the clips go through worker.ts,
    // which answers byte ranges: without them a video cannot be seeked.
    "run_worker_first": ["/video/*"]
  },
  // /api/chat spends the Anthropic key, so each visitor IP gets 10 messages a
  // minute (period can only be 10 or 60). namespace_id is any number that is
  // unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
