{
  "name": "my-portofolio",
  "compatibility_date": "2026-05-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pavletosic.com",
      "custom_domain": true
    }
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // /api/chat spends the Gemini key, so each visitor IP gets 10 messages a
  // minute (period can only be 10 or 60). namespace_id is any number that is
  // unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
